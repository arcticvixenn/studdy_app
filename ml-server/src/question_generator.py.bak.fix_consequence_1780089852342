from typing import List, Dict, Optional, Tuple
import random
import re

from src.text_preprocessor import split_sentences, tokenize
from src.answer_candidate_model import AnswerCandidateModel


BAD_WORDS = {
    "і", "й", "та", "або", "але", "що", "це", "як", "для", "на", "у", "в", "до",
    "з", "із", "за", "про", "при", "від", "над", "під", "між", "через",
    "є", "бути", "було", "були", "може", "можуть", "має", "мають",
    "який", "яка", "яке", "які", "також", "тому", "наприклад",
    "вона", "вони", "воно", "він", "цей", "ця", "його", "її",
}

BAD_SINGLE_TERMS = {
    "показує", "відображає", "змушує", "дозволяє", "дозволяють",
    "використовується", "використовуються", "впливає", "впливають",
    "змінює", "змінюють", "формується", "формуються",
    "виробників", "споживачів", "товар", "товару", "функції",
    "управління", "суспільства", "реформи", "реформ",
    "значення", "результат", "умови", "коду",
    "політичні", "економічні", "успішних", "причиною",
    "наслідком", "ефективності", "підвищення", "повернене",
    "містить", "всередину", "готовність", "бажання",
}

PRONOUNS = {"вона", "вони", "воно", "він", "цей", "ця", "це", "його", "її"}

BAD_PHRASE_PARTS = [
    "які використовуються",
    "наприклад клас",
    "наприклад",
    "на основі",
    "у якій",
    "який дозволяє",
    "стінку хлоропласти та велику",
    "мембрану цитоплазму та генетичний",
    "органели які виконують різні",
    "час якого утворюються органічні",
]


class QuestionGenerator:
    def __init__(self):
        random.seed(42)
        self.answer_model = AnswerCandidateModel()
        self.answer_model.load()
        self.local_term_pool: List[str] = []
        self.local_long_pool: List[str] = []

    def clean_text(self, value: str) -> str:
        value = str(value or "").strip()
        value = re.sub(r"\s+", " ", value)
        value = value.strip(" ,.;:—-")
        return value

    def normalize(self, value: str) -> str:
        return self.clean_text(value).lower().replace("’", "'")

    def has_bad_phrase(self, value: str) -> bool:
        lower = self.normalize(value)
        return any(part in lower for part in BAD_PHRASE_PARTS)

    def token_overlap(self, a: str, b: str) -> float:
        a_tokens = set(tokenize(a))
        b_tokens = set(tokenize(b))

        if not a_tokens or not b_tokens:
            return 0.0

        return len(a_tokens & b_tokens) / max(len(a_tokens | b_tokens), 1)

    def is_too_similar(self, a: str, b: str) -> bool:
        a_norm = self.normalize(a)
        b_norm = self.normalize(b)

        if not a_norm or not b_norm:
            return True

        if a_norm == b_norm:
            return True

        if len(a_norm) >= 5 and len(b_norm) >= 5:
            if a_norm in b_norm or b_norm in a_norm:
                return True

        return self.token_overlap(a_norm, b_norm) >= 0.72

    def is_good_term_answer(self, answer: str) -> bool:
        answer = self.clean_text(answer)
        lower = self.normalize(answer)
        words = lower.split()

        if len(answer) < 4:
            return False

        if not words:
            return False

        if lower in PRONOUNS:
            return False

        if len(words) == 1 and lower in BAD_SINGLE_TERMS:
            return False

        if self.has_bad_phrase(answer):
            return False

        if len(words) > 6:
            return False

        if words[0] in BAD_WORDS or words[-1] in BAD_WORDS:
            return False

        return True

    def is_good_long_answer(self, answer: str) -> bool:
        answer = self.clean_text(answer)
        lower = self.normalize(answer)
        words = lower.split()

        if len(answer) < 6:
            return False

        if not words:
            return False

        if self.has_bad_phrase(answer):
            return False

        if len(words) > 22:
            return False

        if words[-1] in BAD_WORDS:
            return False

        bad_count = sum(1 for word in words if word in BAD_WORDS)

        if bad_count / len(words) > 0.55:
            return False

        return True

    def add_unique(self, items: List[str], value: str, max_items: int = 80) -> None:
        value = self.clean_text(value)

        if not value:
            return

        if any(self.is_too_similar(value, existing) for existing in items):
            return

        items.append(value)

        if len(items) > max_items:
            del items[max_items:]

    def make_result(
        self,
        question_text: str,
        answer: str,
        answer_type: str,
        term: str,
    ) -> Optional[Dict]:
        answer = self.clean_text(answer)
        term = self.clean_text(term)

        if answer_type == "long":
            if not self.is_good_long_answer(answer):
                return None
        else:
            if not self.is_good_term_answer(answer):
                return None

        return {
            "questionText": question_text,
            "answer": answer,
            "answerType": answer_type,
            "term": term,
        }

    def try_definition_pattern(self, sentence: str) -> Optional[Dict]:
        s = self.clean_text(sentence)

        patterns = [
            r"^(.+?)\s+—\s+це\s+(.+?)\.?$",
            r"^(.+?)\s+є\s+(.+?)\.?$",
            r"^(.+?)\s+називають\s+(.+?)\.?$",
        ]

        for pattern in patterns:
            match = re.match(pattern, s, flags=re.IGNORECASE)

            if not match:
                continue

            term = self.clean_text(match.group(1))
            answer = self.clean_text(match.group(2))

            if not self.is_good_term_answer(term):
                continue

            return self.make_result(
                question_text=f"Що таке «{term}»?",
                answer=answer,
                answer_type="long",
                term=term,
            )

        return None

    def try_function_pattern(self, sentence: str) -> Optional[Dict]:
        s = self.clean_text(sentence)

        patterns = [
            (r"^(.+?)\s+(показує)\s+(.+?)\.?$", "Що показує поняття «{term}»?"),
            (r"^(.+?)\s+(відображає)\s+(.+?)\.?$", "Що відображає поняття «{term}»?"),
            (r"^(.+?)\s+(забезпечує|забезпечують)\s+(.+?)\.?$", "Що забезпечує поняття «{term}»?"),
            (r"^(.+?)\s+(зберігає|зберігають)\s+(.+?)\.?$", "Що зберігає поняття «{term}»?"),
            (r"^(.+?)\s+(відмежовує|відмежовують)\s+(.+?)\.?$", "Що відмежовує поняття «{term}»?"),
            (r"^(.+?)\s+(містить|містять)\s+(.+?)\.?$", "Що містить поняття «{term}»?"),
            (r"^(.+?)\s+(здійснює|здійснюють)\s+(.+?)(,\s+.+)?\.?$", "Що здійснює поняття «{term}»?"),
            (r"^(.+?)\s+(бере участь|беруть участь)\s+(.+?)\.?$", "У чому бере участь поняття «{term}»?"),
            (r"^(.+?)\s+(змушує|змушують)\s+(.+?)\.?$", "До чого спонукає поняття «{term}»?"),
            (r"^(.+?)\s+(впливає|впливають)\s+на\s+(.+?)\.?$", "На що впливає поняття «{term}»?"),
            (r"^(.+?)\s+(змінює|змінюють)\s+(.+?)\.?$", "Що змінює поняття «{term}»?"),
            (r"^(.+?)\s+(дозволяє|дозволяють)\s+(.+?)\.?$", "Що дозволяє виконувати поняття «{term}»?"),
        ]

        for pattern, question_template in patterns:
            match = re.match(pattern, s, flags=re.IGNORECASE)

            if not match:
                continue

            term = self.clean_text(match.group(1))
            answer = self.clean_text(match.group(3))

            if not self.is_good_term_answer(term):
                continue

            return self.make_result(
                question_text=question_template.format(term=term),
                answer=answer,
                answer_type="long",
                term=term,
            )

        return None

    def try_composition_pattern(self, sentence: str) -> Optional[Dict]:
        s = self.clean_text(sentence)

        patterns = [
            r"^(.+?)\s+має\s+(.+?)\.?$",
            r"^(.+?)\s+мають\s+(.+?)\.?$",
            r"^(.+?)\s+складається\s+з\s+(.+?)\.?$",
            r"^(.+?)\s+поділяється\s+на\s+(.+?)\.?$",
        ]

        for pattern in patterns:
            match = re.match(pattern, s, flags=re.IGNORECASE)

            if not match:
                continue

            term = self.clean_text(match.group(1))
            answer = self.clean_text(match.group(2))

            if not self.is_good_term_answer(term):
                continue

            return self.make_result(
                question_text=f"Що характерно для поняття «{term}»?",
                answer=answer,
                answer_type="long",
                term=term,
            )

        return None

    def try_cause_effect_pattern(self, sentence: str) -> Optional[Dict]:
        s = self.clean_text(sentence)

        direct_patterns = [
            (r"^(.+?)\s+формується\s+під\s+впливом\s+(.+?)\.?$", "Під впливом чого формується поняття «{term}»?"),
            (r"^(.+?)\s+спричиняє\s+(.+?)\.?$", "Що спричиняє поняття «{term}»?"),
            (r"^(.+?)\s+призводить до\s+(.+?)\.?$", "До чого призводить поняття «{term}»?"),
        ]

        for pattern, question_template in direct_patterns:
            match = re.match(pattern, s, flags=re.IGNORECASE)

            if not match:
                continue

            term = self.clean_text(match.group(1))
            answer = self.clean_text(match.group(2))

            if not self.is_good_term_answer(term):
                continue

            return self.make_result(
                question_text=question_template.format(term=term),
                answer=answer,
                answer_type="long",
                term=term,
            )

        match = re.match(
            r"^Причиною\s+(.+?)\s+.*?стає\s+(.+?)\.?$",
            s,
            flags=re.IGNORECASE,
        )

        if match:
            term = self.clean_text(match.group(1))
            answer = self.clean_text(match.group(2))

            return self.make_result(
                question_text=f"Що часто є причиною поняття «{term}»?",
                answer=answer,
                answer_type="long",
                term=term,
            )

        match = re.match(
            r"^Наслідком\s+(.+?)\s+.*?може\s+бути\s+(.+?)\.?$",
            s,
            flags=re.IGNORECASE,
        )

        if match:
            term = self.clean_text(match.group(1))
            answer = self.clean_text(match.group(2))

            return self.make_result(
                question_text=f"Що може бути наслідком поняття «{term}»?",
                answer=answer,
                answer_type="long",
                term=term,
            )

        return None

    def try_purpose_pattern(self, sentence: str) -> Optional[Dict]:
        s = self.clean_text(sentence)

        patterns = [
            (r"^(.+?)\s+використовується\s+для\s+(.+?)\.?$", "Для чого використовується поняття «{term}»?", "для {answer}"),
            (r"^(.+?)\s+використовуються\s+для\s+(.+?)\.?$", "Для чого використовуються поняття «{term}»?", "для {answer}"),
            (r"^(.+?)\s+застосовується\s+для\s+(.+?)\.?$", "Для чого застосовується поняття «{term}»?", "для {answer}"),
        ]

        for pattern, question_template, answer_template in patterns:
            match = re.match(pattern, s, flags=re.IGNORECASE)

            if not match:
                continue

            term = self.clean_text(match.group(1))
            raw_answer = self.clean_text(match.group(2))
            answer = self.clean_text(answer_template.format(answer=raw_answer))

            if not self.is_good_term_answer(term):
                continue

            return self.make_result(
                question_text=question_template.format(term=term),
                answer=answer,
                answer_type="long",
                term=term,
            )

        return None

    def try_pattern_question(self, sentence: str) -> Optional[Dict]:
        methods = [
            self.try_definition_pattern,
            self.try_function_pattern,
            self.try_composition_pattern,
            self.try_cause_effect_pattern,
            self.try_purpose_pattern,
        ]

        for method in methods:
            result = method(sentence)

            if result:
                return result

        return None

    def extract_local_terms(self, text: str, keywords: List[str]) -> List[str]:
        sentences = split_sentences(text)
        result = []

        for keyword in keywords:
            keyword = self.clean_text(keyword)

            if self.is_good_term_answer(keyword):
                self.add_unique(result, keyword)

        for sentence in sentences:
            pattern_result = self.try_pattern_question(sentence)

            if pattern_result and self.is_good_term_answer(pattern_result.get("term", "")):
                self.add_unique(result, pattern_result["term"])

            tokens = tokenize(sentence)

            for n in range(2, 4):
                for i in range(0, len(tokens) - n + 1):
                    phrase = self.clean_text(" ".join(tokens[i:i + n]))

                    if self.is_good_term_answer(phrase):
                        self.add_unique(result, phrase)

        return result[:60]

    def extract_local_long_answers(self, sentences: List[str]) -> List[str]:
        result = []

        for sentence in sentences:
            pattern_result = self.try_pattern_question(sentence)

            if pattern_result and pattern_result["answerType"] == "long":
                answer = pattern_result["answer"]

                if self.is_good_long_answer(answer):
                    self.add_unique(result, answer)

        return result[:60]

    def get_local_distractors(self, correct_answer: str, answer_type: str) -> List[str]:
        pool = self.local_long_pool if answer_type == "long" else self.local_term_pool
        result = []

        for candidate in pool:
            if self.is_too_similar(correct_answer, candidate):
                continue

            if answer_type == "long" and not self.is_good_long_answer(candidate):
                continue

            if answer_type != "long" and not self.is_good_term_answer(candidate):
                continue

            result.append(candidate)

            if len(result) == 3:
                break

        return result

    def make_options(self, correct_answer: str, answer_type: str) -> Tuple[Optional[List[str]], Optional[str]]:
        correct_answer = self.clean_text(correct_answer)
        distractors = self.get_local_distractors(correct_answer, answer_type)

        if len(distractors) < 3:
            return None, None

        options = [correct_answer] + distractors
        random.shuffle(options)

        correct_index = options.index(correct_answer)
        correct_option = ["A", "B", "C", "D"][correct_index]

        return options, correct_option

    def find_term_answer_in_sentence(self, sentence: str, keywords: List[str]) -> Optional[str]:
        sentence_lower = sentence.lower()

        for keyword in sorted(keywords, key=len, reverse=True):
            keyword = self.clean_text(keyword)

            if keyword and keyword.lower() in sentence_lower and self.is_good_term_answer(keyword):
                return keyword

        for term in self.local_term_pool:
            if term.lower() in sentence_lower and self.is_good_term_answer(term):
                return term

        ranked = self.answer_model.rank_candidates(
            sentence=sentence,
            context=sentence,
            limit=15,
        )

        for item in ranked:
            candidate = self.clean_text(item["candidate"])

            if len(self.normalize(candidate).split()) == 1:
                continue

            if self.is_good_term_answer(candidate):
                return candidate

        return None

    def make_fallback_question(self, sentence: str, answer: str) -> str:
        short_sentence = self.clean_text(sentence)

        if len(short_sentence) > 150:
            short_sentence = short_sentence[:147].rstrip() + "..."

        return f"Яке ключове поняття згадується в твердженні: «{short_sentence}»?"

    def build_question(
        self,
        question_text: str,
        answer: str,
        topic: str,
        difficulty: int,
        order: int,
        source_sentence: str,
        answer_type: str = "term",
        term: str = "",
    ) -> Optional[Dict]:
        answer = self.clean_text(answer)

        if answer_type == "long":
            if not self.is_good_long_answer(answer):
                return None
        else:
            if not self.is_good_term_answer(answer):
                return None

        options, correct_option = self.make_options(
            correct_answer=answer,
            answer_type=answer_type,
        )

        if not options or not correct_option:
            return None

        return {
            "questionText": question_text,
            "optionA": options[0],
            "optionB": options[1],
            "optionC": options[2],
            "optionD": options[3],
            "correctOption": correct_option,
            "explanation": f"Правильна відповідь: «{answer}», оскільки це випливає з навчального матеріалу: «{source_sentence}».",
            "topic": topic,
            "difficulty": difficulty,
            "questionOrder": order,
            "sourceSentence": source_sentence,
        }

    def quality_score_sentence(self, sentence: str, keywords: List[str]) -> int:
        tokens = tokenize(sentence)
        keyword_set = set([k.lower() for k in keywords])

        score = 0
        score += len(set(tokens) & keyword_set) * 4
        score += min(len(sentence) // 40, 6)

        lower = sentence.lower()

        pattern_markers = [
            "— це", " є ", "має", "мають", "містить", "містять",
            "зберігає", "забезпечує", "забезпечують", "відмежовує",
            "здійснює", "здійснюють", "бере участь", "беруть участь",
            "використовується", "використовуються", "складається",
            "поділяється", "призводить", "спричиняє", "формується",
            "показує", "відображає", "змушує", "впливає", "впливають",
            "змінює", "змінюють", "дозволяє", "дозволяють",
            "причиною", "наслідком",
        ]

        if any(marker in lower for marker in pattern_markers):
            score += 20

        return score

    def generate_questions(
        self,
        text: str,
        keywords: List[str],
        difficulty_model,
        topic: str,
        count: int = 5,
    ) -> List[Dict]:
        sentences = split_sentences(text)

        if not sentences:
            return []

        ranked_sentences = sorted(
            sentences,
            key=lambda s: self.quality_score_sentence(s, keywords),
            reverse=True,
        )

        self.local_term_pool = self.extract_local_terms(text, keywords)
        self.local_long_pool = self.extract_local_long_answers(ranked_sentences)

        questions = []
        used_answers = set()
        used_sentences = set()
        used_question_texts = set()

        for sentence in ranked_sentences:
            if len(questions) >= count:
                break

            if sentence in used_sentences:
                continue

            pattern_result = self.try_pattern_question(sentence)

            if not pattern_result:
                continue

            answer = self.clean_text(pattern_result["answer"])
            answer_key = self.normalize(answer)
            question_text = pattern_result["questionText"]

            if answer_key in used_answers:
                continue

            if self.normalize(question_text) in used_question_texts:
                continue

            difficulty = difficulty_model.predict(sentence)

            question = self.build_question(
                question_text=question_text,
                answer=answer,
                topic=topic,
                difficulty=difficulty,
                order=len(questions) + 1,
                source_sentence=sentence,
                answer_type=pattern_result["answerType"],
                term=pattern_result.get("term", ""),
            )

            if not question:
                continue

            used_answers.add(answer_key)
            used_sentences.add(sentence)
            used_question_texts.add(self.normalize(question_text))
            questions.append(question)

        for sentence in ranked_sentences:
            if len(questions) >= count:
                break

            if sentence in used_sentences:
                continue

            answer = self.find_term_answer_in_sentence(sentence, keywords)

            if not answer:
                continue

            answer = self.clean_text(answer)

            if len(self.normalize(answer).split()) == 1:
                continue

            answer_key = self.normalize(answer)

            if answer_key in used_answers:
                continue

            question_text = self.make_fallback_question(sentence, answer)

            if self.normalize(question_text) in used_question_texts:
                continue

            difficulty = difficulty_model.predict(sentence)

            question = self.build_question(
                question_text=question_text,
                answer=answer,
                topic=topic,
                difficulty=difficulty,
                order=len(questions) + 1,
                source_sentence=sentence,
                answer_type="term",
                term=answer,
            )

            if not question:
                continue

            used_answers.add(answer_key)
            used_sentences.add(sentence)
            used_question_texts.add(self.normalize(question_text))
            questions.append(question)

        return questions[:count]
