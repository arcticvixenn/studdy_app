const ensureArray = (value) => (Array.isArray(value) ? value : []);
const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

const numberFrom = (...values) => {
  for (const value of values) {
    if (typeof value === 'number' && !Number.isNaN(value)) return value;
    if (typeof value === 'string' && value.trim() !== '' && !Number.isNaN(Number(value))) {
      return Number(value);
    }
  }
  return 0;
};

const getRankByLevel = (level) => {
  if (level >= 26) return 'Studdy Master';
  if (level >= 19) return 'Data Specialist';
  if (level >= 13) return 'ML Explorer';
  if (level >= 8) return 'Аналітик';
  if (level >= 4) return 'Дослідник';
  return 'Новачок';
};

const getTopicName = (topic) =>
  topic?.topic || topic?.name || topic?.title || 'Тема';

const getTopicAccuracy = (topic) =>
  numberFrom(topic?.accuracy, topic?.accuracyPercent, topic?.mastery, topic?.score);

const getTopicTotal = (topic) =>
  numberFrom(topic?.total, topic?.attempts, topic?.answersCount, topic?.questionsCount);

const getTopicCorrect = (topic) =>
  numberFrom(topic?.correct, topic?.correctCount, topic?.successCount);

const getTopicIncorrect = (topic) =>
  numberFrom(
    topic?.incorrect,
    topic?.incorrectCount,
    getTopicTotal(topic) - getTopicCorrect(topic)
  );

const getTopicLevel = (accuracy) => {
  if (accuracy >= 80) return 'Сильний';
  if (accuracy >= 60) return 'Впевнений';
  if (accuracy >= 40) return 'Базовий';
  return 'Слабкий';
};

const getLevelStyles = (level) => {
  if (level === 'Сильний') {
    return {
      text: 'text-secondary',
      chip: 'bg-green-500/20 border-green-500/40',
      bar: 'bg-green-400',
      icon: '🟢',
    };
  }

  if (level === 'Впевнений') {
    return {
      text: 'text-yellow-300',
      chip: 'bg-yellow-500/20 border-yellow-500/40',
      bar: 'bg-yellow-300',
      icon: '🟡',
    };
  }

  if (level === 'Базовий') {
    return {
      text: 'text-orange-300',
      chip: 'bg-orange-500/20 border-orange-500/40',
      bar: 'bg-orange-300',
      icon: '🟠',
    };
  }

  return {
    text: 'text-red-300',
    chip: 'bg-red-500/20 border-red-500/40',
    bar: 'bg-red-400',
    icon: '🔴',
  };
};

const openRecommendation = (item) => {
  if (!item) return;

  if (item.type === 'course') {
    router.push(`/course/${item.id}`);
    return;
  }

  if (item.type === 'lesson') {
    router.push(`/lesson/${item.id}`);
    return;
  }

  if (item.type === 'post') {
    router.push(`/post/${item.id}`);
  }
};

