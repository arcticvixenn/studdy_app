const Learn = () => {
  const { user } = useGlobalContext();

  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [showMlDetails, setShowMlDetails] = useState(false);

  const [learningStats, setLearningStats] = useState(null);
  const [mlRecommendations, setMlRecommendations] = useState(null);
  const [knowledgeMastery, setKnowledgeMastery] = useState(null);
  const [contentRecommendations, setContentRecommendations] = useState(null);

  const loadLearningHub = async () => {
    if (!user?.$id) return;

    setLoading(true);

    try {
      const [statsRes, mlRes, masteryRes, contentRes] = await Promise.all([
        getUserLearningStats(user.$id),
        getUserMlLearningRecommendations(user.$id),
        getUserKnowledgeMastery(user.$id),
        getUserContentRecommendations(user.$id),
      ]);

      setLearningStats(statsRes || {});
      setMlRecommendations(mlRes || {});
      setKnowledgeMastery(masteryRes || {});
      setContentRecommendations(contentRes || {});
    } catch (error) {
      console.log('learn hub load error:', error);
      setLearningStats({});
      setMlRecommendations({});
      setKnowledgeMastery({});
      setContentRecommendations({});
    } finally {
      setLoading(false);
    }
  };

  useFocusEffect(
    useCallback(() => {
      loadLearningHub();
    }, [user?.$id])
  );

  const onRefresh = async () => {
    setRefreshing(true);
    await loadLearningHub();
    setRefreshing(false);
  };

  const dashboard = useMemo(() => {
    const stats = learningStats || {};
    const mastery = knowledgeMastery || {};
    const content = contentRecommendations || {};
    const ml = mlRecommendations || {};

    const topics = ensureArray(
      mastery?.topics ||
        mastery?.knowledgeMap ||
        mastery?.masteryTopics ||
        stats?.topics
    )
      .map((topic) => {
        const accuracy = clamp(getTopicAccuracy(topic), 0, 100);

        return {
          ...topic,
          topic: getTopicName(topic),
          accuracy,
          total: getTopicTotal(topic),
          correct: getTopicCorrect(topic),
          incorrect: getTopicIncorrect(topic),
          level: topic?.level || getTopicLevel(accuracy),
        };
      })
      .sort((a, b) => b.accuracy - a.accuracy);

    const weakTopics = [...topics]
      .filter((item) => item.accuracy < 60)
      .sort((a, b) => a.accuracy - b.accuracy);

    const strongTopics = [...topics]
      .filter((item) => item.accuracy >= 60)
      .sort((a, b) => b.accuracy - a.accuracy);

    const topSkills = (strongTopics.length ? strongTopics : topics).slice(0, 4);
    const focusTopic = weakTopics[0] || topics[0] || null;

    const completedCourses = numberFrom(
      stats?.completedCourses,
      stats?.coursesCompleted,
      stats?.totalCompletedCourses
    );

    const completedLessons = numberFrom(
      stats?.completedLessons,
      stats?.lessonsCompleted,
      stats?.totalLessonsCompleted
    );

    const totalAnswers = numberFrom(
      stats?.totalAnswers,
      stats?.answersCount,
      stats?.quizAnswersCount,
      stats?.totalQuizAnswers
    );

    const correctAnswers = numberFrom(
      stats?.correctAnswers,
      stats?.correctCount,
      stats?.correctQuizAnswers
    );

    const wrongAnswers = Math.max(totalAnswers - correctAnswers, 0);

    const savedCount = numberFrom(
      stats?.savedCount,
      stats?.savedPosts,
      stats?.totalSavedPosts
    );

    const likedCount = numberFrom(
      stats?.likedCount,
      stats?.likedPosts,
      stats?.totalLikes
    );

    const commentsCount = numberFrom(
      stats?.commentsCount,
      stats?.totalComments,
      stats?.commentedPosts
    );

    const streakDays = numberFrom(
      stats?.streakDays,
      stats?.activeDays,
      stats?.currentStreak
    );

    const totalScore = numberFrom(
      stats?.totalScore,
      stats?.score,
      stats?.xpScore
    );

    const rawAccuracy = totalAnswers
      ? Math.round((correctAnswers / totalAnswers) * 100)
      : numberFrom(stats?.accuracy, stats?.accuracyPercent);

    const studyPower = clamp(
      Math.round(
        rawAccuracy * 0.45 +
          completedLessons * 2 +
          completedCourses * 4 +
          Math.min(streakDays * 3, 25)
      ),
      0,
      100
    );

    const xp =
      totalScore ||
      completedCourses * 120 +
        completedLessons * 35 +
        correctAnswers * 14 +
        totalAnswers * 4 +
        likedCount * 3 +
        savedCount * 5 +
        commentsCount * 6 +
        streakDays * 10;

    const xpPerLevel = 280;
    const level = Math.max(1, Math.floor(xp / xpPerLevel) + 1);
    const currentLevelXpBase = (level - 1) * xpPerLevel;
    const nextLevelXpBase = level * xpPerLevel;
    const levelProgress = clamp(
      Math.round(((xp - currentLevelXpBase) / xpPerLevel) * 100),
      0,
      100
    );

    const rank = getRankByLevel(level);

    const recommendations = ensureArray(content?.recommendations).slice(0, 4);
    const repeatRecommendations = ensureArray(ml?.recommendations).slice(0, 4);

    const achievements = [
      {
        icon: '🎯',
        title: 'Перший прорив',
        description: 'Дай 10 правильних відповідей',
        unlocked: correctAnswers >= 10,
      },
      {
        icon: '📚',
        title: 'Любитель курсів',
        description: 'Заверши хоча б 1 курс',
        unlocked: completedCourses >= 1,
      },
      {
        icon: '⚡',
        title: 'Серія активності',
        description: 'Підтримуй активність 3 дні',
        unlocked: streakDays >= 3,
      },
      {
        icon: '💡',
        title: 'Розумний вибір',
        description: 'Збережи 3 корисні матеріали',
        unlocked: savedCount >= 3,
      },
      {
        icon: '🧠',
        title: 'Точний мозок',
        description: 'Отримай 70%+ точності',
        unlocked: rawAccuracy >= 70,
      },
      {
        icon: '🚀',
        title: 'Новий рівень',
        description: 'Досягни рівня 5',
        unlocked: level >= 5,
      },
    ];

    const questTasks = [
      {
        icon: '🎬',
        title: 'Подивись 1 коротке навчальне відео',
        description: 'Легкий старт для швидкого входу в навчання.',
        xp: 15,
        done: false,
        onPress: () => router.push('/videos'),
      },
      {
        icon: '🧩',
        title: focusTopic
          ? `Прокачай тему "${focusTopic.topic}"`
          : 'Прокачай слабку тему',
        description: focusTopic
          ? `Твій поточний рівень у темі — ${focusTopic.accuracy}%.`
          : 'Studdy допоможе знайти, що повторити в першу чергу.',
        xp: 35,
        done: false,
        onPress: () => {
          const focusLessonId = repeatRecommendations[0]?.lessonId;
          if (focusLessonId) {
            router.push(`/lesson/${focusLessonId}`);
            return;
          }

          if (recommendations[0]) {
            openRecommendation(recommendations[0]);
            return;
          }

          router.push('/home');
        },
      },
      {
        icon: '📝',
        title: 'Зроби швидкий ML-тест',
        description: 'Перевір себе й отримай нові рекомендації.',
        xp: 45,
        done: false,
        onPress: () => router.push('/quiz/ml-preview'),
      },
    ];

    const quickActions = [
      {
        emoji: '⏱️',
        title: 'У мене є 5 хвилин',
        subtitle: '1 shorts + 1 пояснення + 1 швидке питання.',
        onPress: () => router.push('/videos'),
      },
      {
        emoji: '📖',
        title: 'Поясни мені простіше',
        subtitle: focusTopic
          ? `Почнемо з теми "${focusTopic.topic}".`
          : 'Studdy підбере просте пояснення найважливішої теми.',
        onPress: () => {
          if (recommendations[0]) {
            openRecommendation(recommendations[0]);
            return;
          }

          router.push('/home');
        },
      },
      {
        emoji: '🏁',
        title: 'Побити свій результат',
        subtitle: `Зараз твоя точність ${rawAccuracy}%. Спробуй більше.`,
        onPress: () => router.push('/quiz/ml-preview'),
      },
    ];

    const knowledgePlan = (weakTopics.length ? weakTopics : topics).slice(0, 5);

    return {
      completedCourses,
      completedLessons,
      totalAnswers,
      correctAnswers,
      wrongAnswers,
      savedCount,
      likedCount,
      commentsCount,
      streakDays,
      rawAccuracy,
      studyPower,
      xp,
      level,
      levelProgress,
      nextLevelXpBase,
      rank,
      topics,
      weakTopics,
      strongTopics,
      topSkills,
      focusTopic,
      achievements,
      questTasks,
      quickActions,
      recommendations,
      repeatRecommendations,
      knowledgePlan,
      ml,
      content,
    };
  }, [learningStats, mlRecommendations, knowledgeMastery, contentRecommendations]);

  if (loading) {
    return (
      <SafeAreaView className="bg-primary h-full justify-center items-center">
        <ActivityIndicator size="large" color="#FF9C01" />
        <Text className="text-gray-100 mt-4">
          Studdy готує твій навчальний простір...
        </Text>
      </SafeAreaView>
    );
  }

  return (
    <SafeAreaView className="bg-primary h-full">
      <ScrollView
        className="px-4 pt-5"
        refreshControl={
          <RefreshControl refreshing={refreshing} onRefresh={onRefresh} />
        }
        contentContainerStyle={{ paddingBottom: 40 }}
        showsVerticalScrollIndicator={false}
      >
        <View className="rounded-[32px] overflow-hidden mb-5 border border-secondary/30">
          <View className="bg-secondary px-5 pt-5 pb-3">
            <View className="flex-row justify-between items-start">
              <View className="flex-1 pr-4">
                <Text className="text-primary text-sm font-pmedium">
                  Твій простір навчання
                </Text>

                <Text className="text-primary text-[28px] font-psemibold mt-1">
                  Привіт, {user?.username || 'Studdy'} ✨
                </Text>

                <Text className="text-primary/80 text-sm mt-2 leading-5">
                  Комфортно, цікаво і персонально. Тут зібрано твій рівень,
                  квести, прокачку навичок та розумні рекомендації.
                </Text>
              </View>

              <View className="bg-primary/15 rounded-[28px] px-4 py-3 border border-primary/20">
                <Text className="text-primary text-xs font-psemibold text-center">
                  LEVEL
                </Text>
                <Text className="text-primary text-3xl font-psemibold text-center mt-1">
                  {dashboard.level}
                </Text>
              </View>
            </View>
          </View>

          <View className="bg-[#2B145C] px-5 py-5">
            <View className="flex-row justify-between items-center mb-3">
              <View>
                <Text className="text-white text-lg font-psemibold">
                  {dashboard.rank}
                </Text>
                <Text className="text-gray-200 text-sm mt-1">
                  {dashboard.xp} XP • до наступного рівня {dashboard.nextLevelXpBase - dashboard.xp} XP
                </Text>
              </View>

              <View className="bg-white/10 rounded-full px-3 py-2">
                <Text className="text-white text-xs font-psemibold">
                  Потужність {dashboard.studyPower}%
                </Text>
              </View>
            </View>

            <View className="h-4 bg-white/10 rounded-full overflow-hidden">
              <View
                className="h-4 bg-white rounded-full"
                style={{ width: `${dashboard.levelProgress}%` }}
              />
            </View>

            <View className="flex-row mt-5 -mx-1">
              <HeroMiniStat emoji="🔥" value={dashboard.streakDays} label="Днів активності" />
              <HeroMiniStat emoji="🎯" value={`${dashboard.rawAccuracy}%`} label="Точність" />
              <HeroMiniStat emoji="📚" value={dashboard.completedCourses} label="Курсів" />
            </View>
          </View>
        </View>

        <SectionCard
          title="Квест дня"
          subtitle={
            dashboard.focusTopic
              ? `Сьогодні фокус на темі "${dashboard.focusTopic.topic}". Маленькі кроки = великий прогрес.`
              : 'Studdy підготував для тебе легкий маршрут, щоб швидко включитися в навчання.'
          }
          badge={`Нагорода ${dashboard.questTasks.reduce((sum, item) => sum + item.xp, 0)} XP`}
        >
          {dashboard.questTasks.map((task, index) => (
            <QuestTask key={`${task.title}-${index}`} item={task} />
          ))}
        </SectionCard>

        <SectionCard
          title="Режим легкого старту"
          subtitle="Коли не хочеться сидіти над навчанням годинами — просто обери коротку дію."
          badge="5 хвилин"
        >
          {dashboard.quickActions.map((item, index) => (
            <QuickAction
              key={`${item.title}-${index}`}
              emoji={item.emoji}
              title={item.title}
              subtitle={item.subtitle}
              onPress={item.onPress}
            />
          ))}
        </SectionCard>

        <SectionCard
          title="Навчальна галактика"
          subtitle="Тут видно твій ритм навчання у більш живому, легкому форматі."
          badge="Cartoon stats"
        >
          <View className="bg-primary border border-black-200 rounded-[28px] p-5">
            <View className="flex-row justify-center items-end flex-wrap">
              <View className="mx-2 my-2">
                <CartoonBubble emoji="⭐" label="XP" value={dashboard.xp} size="xl" tone="yellow" />
              </View>

              <View className="mx-2 my-2">
                <CartoonBubble emoji="🧠" label="Теми" value={dashboard.topSkills.length || 0} size="lg" tone="blue" />
              </View>

              <View className="mx-2 my-2">
                <CartoonBubble emoji="💾" label="Збереж." value={dashboard.savedCount} size="md" tone="pink" />
              </View>

              <View className="mx-2 my-2">
                <CartoonBubble emoji="💬" label="Комент." value={dashboard.commentsCount} size="md" tone="green" />
              </View>

              <View className="mx-2 my-2">
                <CartoonBubble emoji="❤️" label="Лайки" value={dashboard.likedCount} size="sm" tone="secondary" />
              </View>
            </View>
          </View>
        </SectionCard>

        <SectionCard
          title="Прокачка навичок"
          subtitle="Твої навчальні теми подані як шкала прокачки — одразу видно, що вже сильне, а що треба підтягнути."
          badge="Skill map"
        >
          {dashboard.topSkills.length ? (
            dashboard.topSkills.map((topic, index) => (
              <SkillBar key={`${topic.topic}-${index}`} topic={topic} index={index} />
            ))
          ) : (
            <View className="bg-primary border border-black-200 rounded-[22px] p-5">
              <Text className="text-white font-psemibold">
                Поки замало даних для карти навичок
              </Text>

              <Text className="text-gray-100 text-sm mt-2 leading-5">
                Пройди кілька тестів або уроків — і Studdy побудує твою особисту карту знань.
              </Text>
            </View>
          )}
        </SectionCard>

        <SectionCard
          title="Досягнення"
          subtitle="Маленькі перемоги мотивують продовжувати. Збирай бейджі та прокачуй свій профіль."
          badge="Gamification"
        >
          <ScrollView horizontal showsHorizontalScrollIndicator={false}>
            {dashboard.achievements.map((item, index) => (
              <AchievementCard key={`${item.title}-${index}`} item={item} />
            ))}
          </ScrollView>
        </SectionCard>

        <SectionCard
          title="Що тобі варто відкрити зараз"
          subtitle="Це персональні матеріали, які вже враховують твої відповіді, перегляди, лайки, збереження та коментарі."
          badge="Smart picks"
        >
          {dashboard.recommendations.length ? (
            dashboard.recommendations.map((item, index) => (
              <ContentRecommendationCard
                key={`${item.type}-${item.id}-${index}`}
                item={item}
                index={index}
              />
            ))
          ) : (
            <View className="bg-primary border border-black-200 rounded-[22px] p-5">
              <Text className="text-white font-psemibold">
                Рекомендації ще формуються
              </Text>

              <Text className="text-gray-100 text-sm mt-2 leading-5">
                Продовжуй дивитись матеріали, проходити тести та взаємодіяти зі стрічкою — і цей блок стане розумнішим.
              </Text>
            </View>
          )}
        </SectionCard>

        <SectionCard
          title="Куди спрямувати фокус"
          subtitle="Це теми, які зараз найкраще дадуть приріст у навчанні."
          badge="Priority"
        >
          {dashboard.knowledgePlan.length ? (
            dashboard.knowledgePlan.map((topic, index) => (
              <View
                key={`${topic.topic}-${index}`}
                className="bg-primary border border-black-200 rounded-[22px] p-4 mb-3"
              >
                <View className="flex-row justify-between items-center">
                  <Text className="text-white font-psemibold flex-1 pr-3">
                    {topic.topic}
                  </Text>

                  <Text className={`font-psemibold ${getLevelStyles(getTopicLevel(topic.accuracy)).text}`}>
                    {topic.accuracy}%
                  </Text>
                </View>

                <Text className="text-gray-100 text-xs mt-2">
                  Правильних: {topic.correct}/{topic.total || 0} • Помилок: {topic.incorrect}
                </Text>
              </View>
            ))
          ) : (
            <View className="bg-primary border border-black-200 rounded-[22px] p-5">
              <Text className="text-white font-psemibold">
                Теми для повторення ще не визначені
              </Text>
            </View>
          )}
        </SectionCard>

        <TouchableOpacity
          activeOpacity={0.85}
          onPress={() => setShowMlDetails((prev) => !prev)}
          className="bg-black-100 border border-black-200 rounded-[28px] p-5 mb-5"
        >
          <View className="flex-row justify-between items-center">
            <View className="flex-1 pr-3">
              <Text className="text-white text-[22px] font-psemibold">
                Детальний ML-аналіз
              </Text>

              <Text className="text-gray-100 text-sm mt-2 leading-5">
                Тут сховано технічну частину для демонстрації диплома: профіль знань, повторення та модель рекомендацій.
              </Text>
            </View>

            <Text className="text-secondary text-lg font-psemibold">
              {showMlDetails ? '−' : '+'}
            </Text>
          </View>

          {showMlDetails ? (
            <View className="mt-5">
              <View className="bg-primary border border-black-200 rounded-[22px] p-4 mb-3">
                <Text className="text-white font-psemibold">
                  Модель рекомендацій
                </Text>
                <Text className="text-gray-100 text-xs mt-2 leading-5">
                  {dashboard.content?.modelType || dashboard.ml?.modelType || 'Studdy ML'}
                </Text>
              </View>

              <View className="bg-primary border border-black-200 rounded-[22px] p-4 mb-3">
                <Text className="text-white font-psemibold">
                  Профіль знань
                </Text>
                <Text className="text-gray-100 text-xs mt-2 leading-5">
                  Тем у профілі: {dashboard.topics.length} • Сильних: {dashboard.strongTopics.length} • Слабких: {dashboard.weakTopics.length}
                </Text>
              </View>

              {dashboard.repeatRecommendations.length ? (
                dashboard.repeatRecommendations.map((item, index) => (
                  <View
                    key={`${item.topic}-${index}`}
                    className="bg-primary border border-black-200 rounded-[22px] p-4 mb-3"
                  >
                    <View className="flex-row justify-between items-center">
                      <Text className="text-white font-psemibold flex-1 pr-3">
                        {item.topic}
                      </Text>

                      <Text className="text-secondary font-psemibold">
                        {Math.round(numberFrom(item.repeatPriority, 60))}%
                      </Text>
                    </View>

                    <Text className="text-gray-100 text-xs mt-2 leading-5">
                      {item.reason || 'Тема рекомендована для повторення.'}
                    </Text>

                    {item.lessonId ? (
                      <TouchableOpacity
                        onPress={() => router.push(`/lesson/${item.lessonId}`)}
                        activeOpacity={0.85}
                        className="bg-secondary rounded-2xl p-3 mt-4"
                      >
                        <Text className="text-primary text-center font-psemibold">
                          Відкрити урок
                        </Text>
                      </TouchableOpacity>
                    ) : null}
                  </View>
                ))
              ) : (
                <Text className="text-gray-100 text-sm">
                  Поки немає окремих тем для повторення.
                </Text>
              )}
            </View>
          ) : null}
        </TouchableOpacity>
      </ScrollView>
    </SafeAreaView>
  );
};

export default Learn;
